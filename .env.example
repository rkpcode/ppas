# ====================================
# Database & Authentication
# ====================================
DATABASE_URL=sqlite:///./pharmacy.db
JWT_SECRET_KEY="supersecretkey_change_me_in_production"
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ====================================
# NVIDIA API Configuration (LLM, Agent & TTS)
# Get key from: https://build.nvidia.com
# One key for all models!
# ====================================
NVIDIA_API_KEY="nvapi-your-actual-nvidia-api-key-here"
NVIDIA_AGENT_MODEL="deepseek-ai/deepseek-v4-flash"
NVIDIA_FAST_MODEL="meta/llama-3.1-8b-instruct"
NVIDIA_REASONING_MODEL="nvidia/nemotron-3-ultra-550b-a55b"
NVIDIA_TTS_MODEL="resembleai/chatterbox-multilingual-tts"

# ====================================
# Sarvam AI (Voice STT Only)
# ====================================
SARVAM_API_KEY="your-sarvam-api-key-here"
SARVAM_STT_MODEL="saaras:v3"
PUSH_TO_TALK_HOTKEY="f9"

# ====================================
# Legacy / Fallback (Optional)
# ====================================
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
